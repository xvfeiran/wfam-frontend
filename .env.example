# 复制为 .env.local 并按实际情况填写（.env.local 不会提交到 git）

# -------------------------------------------------------
# 调试模式（URL 加 ?dev=1）：前端直接请求后端
# -------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8102/aftermarket-parts-management-system/api/v1

# -------------------------------------------------------
# 微应用模式（子应用，默认）：前端通过网关请求
# 本地开发一般不需要此项；生产 Docker 构建时必须配置
# -------------------------------------------------------
VITE_GATEWAY_URL=https://your-gateway.example.com/api/v1

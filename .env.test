# 测试环境配置（Dockerfile 默认 BUILD_MODE=test，直接 docker build . 即可加载此文件）

# 调试模式（?dev=1）：直接访问测试后端（测试环境 CORS 需放行 x-authentication-header）
VITE_BACKEND_URL=https://wfam-api.quality.tmp-service.bosch.com/aftermarket-parts-management-system/api/v1

# 微应用模式（子应用）：测试环境网关地址
VITE_GATEWAY_URL=https://aepgateway.quality.tmp-service.bosch.com/aftermarket-parts-management-system/api/v1

# 报表分析/质量模块 API 地址
VITE_REPORT_API_URL=https://wfam-task.quality.tmp-service.bosch.com

#报表下拉框接口API地址
VITE_REPORT_OPTION_API_URL=https://wfam-api.quality.tmp-service.bosch.com/aftermarket-parts-management-system/api/v1

# token 过期时重定向至 AEP 测试环境登录页
VITE_AEP_LOGIN_URL=https://aep.quality.tmp-service.bosch.com

# AEP 微应用注册信息
VITE_AEP_APP_NAME=RBCC_WFAM
VITE_AEP_APP_ID=1081

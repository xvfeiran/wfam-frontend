# 生产环境配置
# 构建命令：docker build --build-arg BUILD_MODE=production -t wfam-frontend:prod .
#          （Dockerfile 中 ARG BUILD_MODE 默认为 test，生产构建必须显式传入 production）

# 生产环境为微应用模式，浏览器统一走网关，无需 VITE_BACKEND_URL（仅 ?dev=1 调试模式使用）

# 微应用模式（子应用）：生产环境网关地址
VITE_GATEWAY_URL=https://aep-gateway.production.tmp-service.bosch.com/aftermarket-parts-management-system/api/v1

# 报表分析/质量模块 API 地址
VITE_REPORT_API_URL=https://aep-gateway.production.tmp-service.bosch.com/wfam-task

#报表下拉框接口API地址
VITE_REPORT_OPTION_API_URL=https://aep-gateway.production.tmp-service.bosch.com/aftermarket-parts-management-system/api/v1

# token 过期时重定向至 AEP 生产环境登录页
VITE_AEP_LOGIN_URL=https://aep.production.tmp-service.bosch.com

# AEP 微应用注册信息
VITE_AEP_TAB_PATH=/microApp
VITE_AEP_APP_NAME=RBCC_WFAM
VITE_AEP_APP_ID=1081
